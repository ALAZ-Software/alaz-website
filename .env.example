# Search engine ownership verification (token only, not the full meta tag).
# Google Search Console -> HTML tag -> content="..."
GOOGLE_SITE_VERIFICATION=
# Yandex Webmaster -> Meta tag -> content="..."
YANDEX_VERIFICATION=
# Bing Webmaster Tools -> Meta tag msvalidate.01 -> content="..."
BING_SITE_VERIFICATION=

# ==========================================
# HOSTINGER E-POSTA (SMTP) AYARLARI
# ==========================================
# Hostinger standart e-posta için: smtp.hostinger.com
# Hostinger Titan e-posta için: smtp.titan.email
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@alaz.pro
SMTP_PASS=
# Form bildirimlerinin geleceği e-posta (Boş bırakılırsa SMTP_USER kullanılır):
NOTIFICATION_EMAIL=hello@alaz.pro

# ==========================================
# HOSTINGER MYSQL VERİTABANI AYARLARI
# ==========================================
# Hostinger hPanel -> Veritabanları (Databases) bölümünden alınır.
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_alaz
DB_PASSWORD=
DB_NAME=u123456789_alaz_db
# Veya tek satırlık DATABASE_URL formatı:
# DATABASE_URL=mysql://u123456789_alaz:password@localhost:3306/u123456789_alaz_db

